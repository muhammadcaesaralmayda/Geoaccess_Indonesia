import whitebox

# Inisialisasi WhiteboxTools
wbt = whitebox.WhiteboxTools()
wbt.work_dir = '/content/drive/MyDrive/Data Simulasi/Raster/'  # Gunakan direktori kerja saat ini
wbt.verbose = False  # Non-Aktifkan Tampilkan proses

# File input dan output
input_dem = 'SRTM_YOGYAKARTA.tif'
output_slope = 'slope.tif'

# Hitung slope (%)
wbt.slope(
    dem=input_dem,
    output=output_slope,
    zfactor=1.0,
    units='percent'
)

# Baca hasil slope
with rasterio.open(output_slope) as src:
    slope = src.read(1)

# Tampilkan slope
plt.figure(figsize=(10, 8))
plt.imshow(slope, cmap='magma')
plt.colorbar(label='Slope (%)')
plt.title('Kemiringan Lereng')
plt.axis('off')
plt.show()
